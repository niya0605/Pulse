    "ai": "^4.3.19",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.3",
    "inngest": "^3.42.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
